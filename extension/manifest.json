{
  "manifest_version": 3,
  "name": "Apple TV Remote Helper",
  "version": "4.2",
  "description": "Controla cualquier sitio web (Cuevana, JWPlayer, YouTube, Netflix, etc.) desde tu celular.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://*:8080/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["player.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
